            },
            "then": {
              "properties": {
                "upstream": {
                  "$ref": "#/$defs/source"
                },
                "license": {
                  "const": "Apache-2.0"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "library"
                    ]
                  },
                  {
                    "required": [
                      "no_upstream_proof_text_reused"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "reuse_kind": {
                  "const": "original"
                }
              }
            },
            "then": {
              "properties": {
                "upstream": {
                  "type": "null"
                }
              },
              "required": [
                "no_upstream_proof_text_reused"
              ],
              "not": {
                "required": [
                  "library"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "reuse_kind": {
                  "const": "existing_library"
                }
              }
            },
            "then": {
              "required": [
                "library"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "planned",
                    "replaced",
                    "excluded"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "ported",
                    "replaced"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "verification": {
                  "properties": {
                    "result": {
                      "const": "passed"
                    }
                  }
                },
                "downstream": {
                  "properties": {
                    "name_status": {
                      "const": "declared"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "planned"
                }
              }
            },
            "then": {
              "properties": {
                "verification": {
                  "properties": {
                    "result": {
                      "const": "pending"
                    }
                  }
                },
                "downstream": {
                  "properties": {
                    "name_status": {
                      "const": "proposed"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "replaced"
                }
              }
            },
            "then": {
              "properties": {
                "reuse_kind": {
                  "const": "existing_library"
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "source",
    "entries"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAI mathematics source provenance ledger v1",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
