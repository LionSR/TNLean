        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:#?\\s%])[A-Za-z0-9_.\\-/]+$"
        },
        "declaration": {
          "type": "string",
          "pattern": "^[\\w\\u0080-\\uffff]+(?:[.\\w\\u0080-\\uffff\\u0027]*)$"
        },
        "lines": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "items": false,
          "minItems": 2
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "repository",
        "commit",
        "path",
        "declaration",
        "lines",
        "url"
      ]
    }
  }
