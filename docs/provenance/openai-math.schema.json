                  "minItems": 1
                }
              },
              "required": [
                "version",
                "path",
                "labels"
              ]
            },
            "minItems": 1
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "notices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:#?\\s%])[A-Za-z0-9_.\\-/]+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "source_path",
                "text"
              ]
            },
            "minItems": 0
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "verification": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "result": {
                    "const": "pending"
                  }
                },
                "required": [
                  "result"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "result": {
                    "const": "passed"
                  },
                  "repository": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "enum": [
                            "build",
                            "axioms",
                            "source-audit"
                          ]
                        },
                        "command": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "exit_code": {
                          "const": 0
                        },
                        "log": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:#?\\s%])[A-Za-z0-9_.\\-/]+$"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "kind",
                        "command",
                        "exit_code",
                        "log",
                        "sha256"
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "result",
                  "repository",
                  "revision",
                  "commands"
                ]
              }
            ]
          },
          "library": {
            "$ref": "#/$defs/source"
          },
          "no_upstream_proof_text_reused": {
            "const": true
          }
        },
        "required": [
          "id",
          "status",
          "reuse_kind",
          "upstream",
          "downstream",
          "paper_sources",
          "license",
          "notices",
          "changes",
          "verification"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "reuse_kind": {
                  "enum": [
                    "copied",
                    "adapted"
                  ]
