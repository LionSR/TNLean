import TNLean.PEPS.TorusDualPath

/-!
# Elementary endpoint-preserving dual-string deformations

The relation is generated by cancelling an adjacent step and its reverse,
interchanging the two sides of a dual square, and applying these operations
inside longer paths. It is not defined by equality of states or by existence
of a gauge. An integer vertex potential, supported on the swept primal
vertices, is derived from the moves.

Source: SCP10, arXiv:1001.3807, Lemma 6.14, lines 2199–2214.
The theorem concerns the generated finite homotopies. It does not identify
arbitrary same-endpoint paths in distinct torus winding classes.

**Scope restriction (generated finite dual-lattice homotopies):** See
`docs/paper-gaps/scp10_dual_flux_string_deformation.tex` for the distinction
from unrestricted source wording and arbitrary open-boundary geometries.
-/

namespace TNLean.PEPS

variable {width height : ℕ}
local notation "X" => TorusVertex width height
local instance : Quiver X := torusDualQuiver width height

/-- Native horizontal and downward differences of an integer vertex potential. -/
def torusFluxGradient (f : X → ℤ) : (X → ℤ) × (X → ℤ) :=
  (fun v => f (v.1 + 1, v.2) - f v, fun v => f v - f (v.1, v.2 + 1))

@[simp]
theorem torusFluxGradient_zero : torusFluxGradient (0 : X → ℤ) = 0 := by
  ext v <;> simp [torusFluxGradient]

@[simp]
theorem torusFluxGradient_add (f k : X → ℤ) :
    torusFluxGradient (f + k) = torusFluxGradient f + torusFluxGradient k := by
  ext v <;> simp only [torusFluxGradient, Pi.add_apply, Prod.fst_add, Prod.snd_add] <;> abel

@[simp]
theorem torusFluxGradient_neg (f : X → ℤ) :
    torusFluxGradient (-f) = -torusFluxGradient f := by
  ext v <;> simp [torusFluxGradient] <;> abel

/-- The right-then-up half of a dual square. -/
def torusDualEastNorth (x : ZMod width) (y : ZMod height) :
    TorusDualPath (x, y) (x + 1, y + 1) :=
  (Quiver.Path.nil.cons (TorusDualStep.east x y)).cons (TorusDualStep.north (x + 1) y)

/-- The up-then-right half of the same dual square. -/
def torusDualNorthEast (x : ZMod width) (y : ZMod height) :
    TorusDualPath (x, y) (x + 1, y + 1) :=
  (Quiver.Path.nil.cons (TorusDualStep.north x y)).cons (TorusDualStep.east x (y + 1))

/-- A square move changes crossing counts by the gradient of the point mass
at the enclosed primal vertex. The gauge is calculated from the geometry. -/
theorem torusDualSquare_crossings (x : ZMod width) (y : ZMod height) :
    torusDualPathCrossings (torusDualNorthEast x y) =
      torusDualPathCrossings (torusDualEastNorth x y) +
        torusFluxGradient (torusPointMass (x + 1, y + 1)) := by
  ext ⟨u, v⟩ <;>
    simp [torusDualNorthEast, torusDualEastNorth, TorusDualStep.crossings,
      torusFluxGradient, torusPointMass, Prod.mk.injEq]

/-- Endpoint-fixed deformations generated by backtracks and dual-square moves.
Only a square enclosing a primal vertex in `R` may be swept. Source: SCP10,
Lemma 6.14. No state equality, flatness, or gauge witness is a constructor. -/
inductive TorusDualHomotopy (R : Set X) :
    {a b : X} → TorusDualPath a b → TorusDualPath a b → Prop
  | refl {a b} (p : TorusDualPath a b) : TorusDualHomotopy R p p
  | symm {a b} {p q : TorusDualPath a b} :
      TorusDualHomotopy R p q → TorusDualHomotopy R q p
  | trans {a b} {p q r : TorusDualPath a b} :
      TorusDualHomotopy R p q → TorusDualHomotopy R q r → TorusDualHomotopy R p r
  | comp {a b c} {p p' : TorusDualPath a b} {q q' : TorusDualPath b c} :
      TorusDualHomotopy R p p' → TorusDualHomotopy R q q' →
        TorusDualHomotopy R (p.comp q) (p'.comp q')
  | reverse {a b} {p q : TorusDualPath a b} :
      TorusDualHomotopy R p q → TorusDualHomotopy R p.reverse q.reverse
  | backtrack {a b} (e : TorusDualStep a b) :
      TorusDualHomotopy R ((Quiver.Path.nil.cons e).cons e.reverse) .nil
  | square (x : ZMod width) (y : ZMod height) (h : (x + 1, y + 1) ∈ R) :
      TorusDualHomotopy R (torusDualEastNorth x y) (torusDualNorthEast x y)

/-- Every generated deformation has an explicitly derived integer potential,
zero outside the swept vertices. In particular this is a consequence of the
moves, not a hypothesis defining path equivalence. -/
theorem TorusDualHomotopy.exists_potential {R : Set X} {a b : X}
    {p q : TorusDualPath a b} (h : TorusDualHomotopy R p q) :
    ∃ f : X → ℤ, (∀ v, v ∉ R → f v = 0) ∧
      torusDualPathCrossings q = torusDualPathCrossings p + torusFluxGradient f := by
  induction h with
  | refl p => exact ⟨0, by simp, by simp⟩
  | symm h ih =>
    obtain ⟨f, hf, heq⟩ := ih
    refine ⟨-f, by simpa using hf, ?_⟩
    rw [heq, torusFluxGradient_neg]
    abel
  | trans h k ih ik =>
    obtain ⟨f, hf, heq⟩ := ih
    obtain ⟨k, hk, hkeq⟩ := ik
    refine ⟨f + k, fun v hv => by simp [hf v hv, hk v hv], ?_⟩
    rw [hkeq, heq, torusFluxGradient_add]
    abel
  | comp h k ih ik =>
    obtain ⟨f, hf, heq⟩ := ih
    obtain ⟨k, hk, hkeq⟩ := ik
    refine ⟨f + k, fun v hv => by simp [hf v hv, hk v hv], ?_⟩
    simp only [TorusDualPath.crossings_comp, heq, hkeq, torusFluxGradient_add]
    abel
  | reverse h ih =>
    obtain ⟨f, hf, heq⟩ := ih
    refine ⟨-f, by simpa using hf, ?_⟩
    rw [TorusDualPath.crossings_reverse, TorusDualPath.crossings_reverse,
      heq, torusFluxGradient_neg]
    abel
  | backtrack e => refine ⟨0, by simp, by simp⟩
  | square x y hxy =>
    refine ⟨torusPointMass (x + 1, y + 1), ?_, torusDualSquare_crossings x y⟩
    intro v hv
    have hne : v ≠ (x + 1, y + 1) := fun he => hv (he.symm ▸ hxy)
    simp [torusPointMass, hne]

/-- Retracing any finite path contracts by successive elementary backtracks. -/
theorem TorusDualHomotopy.cancel_reverse (R : Set X) {a b : X}
    (p : TorusDualPath a b) : TorusDualHomotopy R (p.comp p.reverse) .nil := by
  induction p with
  | nil => exact .refl _
  | cons p e ih =>
    have hb : TorusDualHomotopy R
        (Quiver.Hom.toPath e |>.comp (Quiver.Hom.toPath e.reverse)) .nil := .backtrack e
    have hh := (TorusDualHomotopy.comp (.comp (.refl p) hb) (.refl p.reverse))
    have ht := hh.trans ih
    rw [Quiver.Path.reverse, ← Quiver.Path.comp_assoc]
    exact ht

/-- The four sides of a positively oriented dual face enclose one primal site. -/
def torusDualSquareLoop (x : ZMod width) (y : ZMod height) :
    TorusDualPath (x, y) (x, y) :=
  (((Quiver.Path.nil.cons (TorusDualStep.east x y)).cons
    (TorusDualStep.north (x + 1) y)).cons (TorusDualStep.west x (y + 1))).cons
      (TorusDualStep.south x y)

/-- An elementary dual-face loop can be inserted or removed without changing
its endpoints. This follows from one square move and two backtracks. -/
theorem TorusDualHomotopy.squareLoop (R : Set X) (x : ZMod width) (y : ZMod height)
    (h : (x + 1, y + 1) ∈ R) : TorusDualHomotopy R (torusDualSquareLoop x y) .nil := by
  have hh := (TorusDualHomotopy.comp (.square x y h)
    (.refl (torusDualNorthEast x y).reverse)).trans
      (TorusDualHomotopy.cancel_reverse R (torusDualNorthEast x y))
  exact hh

end TNLean.PEPS
