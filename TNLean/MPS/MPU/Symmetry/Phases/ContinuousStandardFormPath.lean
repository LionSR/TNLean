import QICLean.Analysis.Topology.KroneckerPathLifting
import TNLean.MPS.MPU.StandardForm.SourceFactorChoiceGates
import TNLean.MPS.MPU.Symmetry.Phases.StandardFormPathContinuity
import TNLean.MPS.MPU.StandardForm.StandardFormPathGateDims
import TNLean.MPS.MPU.Symmetry.Phases.TimeReversalSignInvariance

/-!
# A continuous choice of standard form along a path

Corollary `coruvSF` of arXiv:1703.09188, lines 867--875: for every continuous
path of tensors `𝒰(p)` generating matrix product unitaries, not necessarily in
canonical form, there are `k₀ ≤ D⁴` and continuous paths of gates `u(p)` and
`v(p)` such that the MPU generated by `𝒰(p)` on `2 k₀ N` sites has a standard
form given by `u(p)` and `v(p)`.

The proof follows the source.
* The gate dimensions are fixed along the path
  (`MPOTensor.IsMPU.exists_standardForm_fixed_gateDims_of_path`).
* The gates are continuous modulo local unitaries
  (`MPOTensor.eventually_exists_gate_gauge_sub_mem_of_path`).
* A local-unitary gauge `x(p) ⊗ y(p)` makes the first gate continuous. The source
  obtains it from the slice theorem of Montgomery and Yang; here it comes from the
  direct construction `Matrix.exists_continuous_lift_of_continuous_mod_localUnitary`,
  recorded in `docs/paper-gaps/mpu_standard_form_path_cross_section.tex`.
* The gauged second gate is continuous. The source reads this off the MPU on one
  block. Here the entries of the second gate are recovered as quotients of entries
  of its shifted layers on rings of two and three blocks, which are continuous
  because the circuits and the first gate are.

## Main statements

* `MPOTensor.continuousAt_of_twoSiteShiftedLayer`: a gate is continuous where its
  shifted layers on two and three blocks are continuous.
* `MPOTensor.IsMPU.exists_continuous_standardForm_of_path`: Corollary `coruvSF`.
-/

open scoped Matrix Kronecker Matrix.Norms.L2Operator
open Filter Topology

namespace MPOTensor

variable {d ℓ r : ℕ}

/-- The layer of a coisometric gate on a ring of blocks is a coisometry. -/
private theorem twoSiteUnshiftedLayer_mul_conjTranspose {N : ℕ}
    {u : Matrix (Fin ℓ × Fin r) (Fin d × Fin d) ℂ} (hu : u * uᴴ = 1) :
    twoSiteUnshiftedLayer (N := N) u * (twoSiteUnshiftedLayer (N := N) u)ᴴ = 1 := by
  ext h h'
  have hentry : ∀ x : Fin N, ∑ k, u (h x) k * star (u (h' x) k) = (1 : Matrix _ _ ℂ) (h x) (h' x) :=
    fun x ↦ by rw [← hu, Matrix.mul_apply]; rfl
  simp only [Matrix.mul_apply, twoSiteUnshiftedLayer, Matrix.conjTranspose_apply, star_prod]
  rw [show (∑ j : Fin N → Fin d × Fin d, (∏ x, u (h x) (j x)) * ∏ x, star (u (h' x) (j x))) =
      ∏ x, ∑ k, u (h x) k * star (u (h' x) k) by
    rw [Fintype.prod_sum]
    exact Finset.sum_congr rfl fun j _ ↦ (Finset.prod_mul_distrib).symm]
  simp only [hentry, Matrix.one_apply, Finset.prod_boole, Finset.mem_univ, true_implies]
  by_cases hh : h = h'
  · simp [hh]
  · have hall : ¬ ∀ x, h x = h' x := fun hall ↦ hh (funext hall)
    simp only [hall, hh, ↓reduceIte]

/-- The entry of the shifted layer on two blocks at a configuration chosen to
read off two given entries of the gate. -/
private theorem twoSiteShiftedLayer_two_apply_pair
    (v : Matrix (Fin d × Fin d) (Fin r × Fin ℓ) ℂ) (a a' : Fin d × Fin d)
    (b b' : Fin r × Fin ℓ) :
    twoSiteShiftedLayer (N := 2) v ![(a'.2, a.1), (a.2, a'.1)] ![(b'.2, b.1), (b.2, b'.1)] =
      v a b * v a' b' := by
  simp [twoSiteShiftedLayer, Fin.prod_univ_two]

/-- The entry of the shifted layer on three blocks at a configuration chosen to
read off three given entries of the gate. -/
private theorem twoSiteShiftedLayer_three_apply_triple
    (v : Matrix (Fin d × Fin d) (Fin r × Fin ℓ) ℂ) (a a₀ : Fin d × Fin d)
    (b b₀ : Fin r × Fin ℓ) :
    twoSiteShiftedLayer (N := 3) v ![(a₀.2, a.1), (a.2, a₀.1), (a₀.2, a₀.1)]
        ![(b₀.2, b.1), (b.2, b₀.1), (b₀.2, b₀.1)] =
      v a b * v a₀ b₀ * v a₀ b₀ := by
  simp [twoSiteShiftedLayer, Fin.prod_univ_three]

/-- **A gate is continuous where its shifted layers are.** If the shifted layers
of `v` on rings of two and three blocks are continuous at `p` and `v p ≠ 0`, then
`v` is continuous at `p`. Near `p` an entry `v_{a₀ b₀}` stays away from zero, and
`v_{ab} = (v_{ab} v_{a₀b₀}²) / v_{a₀b₀}²` is a quotient of entries of the two
layers.

Source: the continuity of `v̂(p)` at the end of the proof of Corollary `coruvSF`,
arXiv:1703.09188, lines 947--950, by an argument recorded in
`docs/paper-gaps/mpu_standard_form_path_cross_section.tex`. -/
theorem continuousAt_of_twoSiteShiftedLayer {P : Type*} [TopologicalSpace P]
    {v : P → Matrix (Fin d × Fin d) (Fin r × Fin ℓ) ℂ} {p : P} (hv : v p ≠ 0)
    (h₂ : ContinuousAt (fun q ↦ twoSiteShiftedLayer (N := 2) (v q)) p)
    (h₃ : ContinuousAt (fun q ↦ twoSiteShiftedLayer (N := 3) (v q)) p) :
    ContinuousAt v p := by
  obtain ⟨a₀, b₀, h₀⟩ : ∃ a b, v p a b ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hv (Matrix.ext hcon)
  have hentry : ∀ {M : ℕ} [NeZero M] {i : Fin M → Fin d × Fin d} {h : Fin M → Fin ℓ × Fin r},
      ContinuousAt (fun q ↦ twoSiteShiftedLayer (N := M) (v q)) p →
      ContinuousAt (fun q ↦ twoSiteShiftedLayer (N := M) (v q) i h) p :=
    fun {_ _ i h} hc ↦ (continuous_apply_apply i h).continuousAt.comp hc
  refine continuousAt_pi.mpr fun a ↦ continuousAt_pi.mpr fun b ↦ ?_
  set den : P → ℂ := fun q ↦ twoSiteShiftedLayer (N := 2) (v q)
    ![(a₀.2, a₀.1), (a₀.2, a₀.1)] ![(b₀.2, b₀.1), (b₀.2, b₀.1)] with hden_def
  set num : P → ℂ := fun q ↦ twoSiteShiftedLayer (N := 3) (v q)
    ![(a₀.2, a.1), (a.2, a₀.1), (a₀.2, a₀.1)] ![(b₀.2, b.1), (b.2, b₀.1), (b₀.2, b₀.1)]
    with hnum_def
  have hden : ContinuousAt den p := hentry h₂
  have hnum : ContinuousAt num p := hentry h₃
  have hden_eq : ∀ q, den q = v q a₀ b₀ * v q a₀ b₀ := fun q ↦
    twoSiteShiftedLayer_two_apply_pair (v q) a₀ a₀ b₀ b₀
  have hnum_eq : ∀ q, num q = v q a b * v q a₀ b₀ * v q a₀ b₀ := fun q ↦
    twoSiteShiftedLayer_three_apply_triple (v q) a a₀ b b₀
  have hden0 : den p ≠ 0 := by rw [hden_eq]; exact mul_ne_zero h₀ h₀
  refine (hnum.div hden hden0).congr ?_
  filter_upwards [hden.eventually_ne hden0] with q hq
  rw [hden_eq] at hq
  have hx : v q a₀ b₀ ≠ 0 := left_ne_zero_of_mul hq
  simp only [Pi.div_apply, hnum_eq, hden_eq]
  field_simp

/-- **Corollary `coruvSF`: a continuous choice of standard form.** Let `p ↦ 𝒰(p)`,
`p ∈ [0, 1]`, be a continuous path of tensors generating matrix product unitaries,
not necessarily in canonical form, with positive physical dimension. There are
`0 < k₀ ≤ D⁴` and continuous paths of gates `u(p)` and `v(p)` such that, for every
`p`, the MPU generated by `𝒰(p)` on `2 k₀ N` sites has a standard form given by
`u(p)` and `v(p)`: some tensor `V` generates the same periodic operators as the
`k₀`-site blocking of `𝒰(p)` at every positive length, and its two-site block
has standard-form data for `u(p)` and `v(p)`. The gate dimensions are fixed by the
index, `ind 𝒰(0) = log₂ (r / d^{k₀})` and `ℓ r = d^{2 k₀}`.

Source: arXiv:1703.09188, Corollary `coruvSF`, lines 867--875, with proof at
lines 876--950. The slice theorem of Montgomery and Yang (lines 942--947) is
replaced by the direct cross-section construction recorded in
`docs/paper-gaps/mpu_standard_form_path_cross_section.tex`. -/
theorem IsMPU.exists_continuous_standardForm_of_path [NeZero d] {D : ℕ}
    {U : unitInterval → MPOTensor d D} (hU : Continuous U) (hMPU : ∀ p, IsMPU (U p)) :
    ∃ k₀, 0 < k₀ ∧ k₀ ≤ D ^ 4 ∧ ∃ (ℓ r : ℕ)
      (u : unitInterval → Matrix (Fin ℓ × Fin r)
        (Fin (Kraus.blockPhysDim d k₀) × Fin (Kraus.blockPhysDim d k₀)) ℂ)
      (v : unitInterval → Matrix (Fin (Kraus.blockPhysDim d k₀) ×
        Fin (Kraus.blockPhysDim d k₀)) (Fin r × Fin ℓ) ℂ),
      (∀ [NeZero D], (hMPU 0).index =
        Real.logb 2 ((r : ℝ) / (Kraus.blockPhysDim d k₀ : ℕ))) ∧
      ℓ * r = Kraus.blockPhysDim d k₀ * Kraus.blockPhysDim d k₀ ∧
      Continuous u ∧ Continuous v ∧ ∀ p, ∃ (D' : ℕ)
        (V : MPOTensor (Kraus.blockPhysDim d k₀) D'),
        (∀ N : ℕ, 0 < N → mpo V N = mpo (MPOTensor.blockTensor (U p) k₀) N) ∧
          Nonempty (TwoSiteStandardFormData (blockTwo V) (u p) (v p)) := by
  have : NeZero D := (hMPU 0).neZero_bond
  refine ⟨D ^ 4, pow_pos (NeZero.pos D) 4, le_rfl, ?_⟩
  obtain ⟨ℓ, r, hind, hℓr, hrep⟩ := IsMPU.exists_standardForm_fixed_gateDims_of_path hU hMPU
  set d' := Kraus.blockPhysDim d (D ^ 4)
  choose D' V u v hV hS using hrep
  have S₀ := (hS 0).some
  have : NeZero ℓ := ⟨S₀.left_pos.ne'⟩
  have : NeZero r := ⟨S₀.right_pos.ne'⟩
  -- A fixed identification of the gate's input space with its output space.
  have hcard : Fintype.card (Fin d' × Fin d') = Fintype.card (Fin ℓ × Fin r) :=
    le_antisymm (S₀.u_unitary.1.card_le _) (S₀.u_unitary.2.card_le _)
  let e : Fin d' × Fin d' ≃ Fin ℓ × Fin r := Fintype.equivOfCardEq hcard
  let sq : Matrix (Fin ℓ × Fin r) (Fin d' × Fin d') ℂ →
      Matrix (Fin ℓ × Fin r) (Fin ℓ × Fin r) ℂ := Matrix.reindex (Equiv.refl _) e
  have hsq_cont : Continuous sq := continuous_id.matrix_reindex _ _
  have hsq_sub : ∀ A B, sq (A - B) = sq A - sq B := fun A B ↦ by
    ext; simp [sq]
  have hsq_mul : ∀ (A : Matrix (Fin ℓ × Fin r) (Fin ℓ × Fin r) ℂ) B, sq (A * B) = A * sq B :=
    fun A B ↦ by
      ext i j
      simp [sq, Matrix.mul_apply]
  have hsq_inj : ∀ A, Matrix.reindex (Equiv.refl _) e.symm (sq A) = A := fun A ↦ by
    ext; simp [sq]
  -- The gates, made square, are unitary and continuous modulo local unitaries.
  have hunit : ∀ p, sq (u p) ∈ Matrix.unitaryGroup (Fin ℓ × Fin r) ℂ := fun p ↦
    (Matrix.isUnitaryBetween_iff_mem_unitaryGroup _).mp
      ((hS p).some.u_unitary.reindex _ _ _)
  have hmod : ∀ p, ∀ ε > 0, ∃ δ > 0, ∀ q, dist q p < δ →
      ∃ (x : unitary (Matrix (Fin ℓ) (Fin ℓ) ℂ)) (y : unitary (Matrix (Fin r) (Fin r) ℂ)),
        ‖sq (u q) - ((x : Matrix (Fin ℓ) (Fin ℓ) ℂ) ⊗ₖ (y : Matrix (Fin r) (Fin r) ℂ)) *
          sq (u p)‖ < ε := by
    intro p ε hε
    have hW : sq ⁻¹' Metric.ball 0 ε ∈ 𝓝 (0 : Matrix (Fin ℓ × Fin r) (Fin d' × Fin d') ℂ) :=
      hsq_cont.continuousAt.preimage_mem_nhds (by
        simpa [sq] using Metric.ball_mem_nhds (0 : Matrix (Fin ℓ × Fin r) (Fin ℓ × Fin r) ℂ) hε)
    have hev := eventually_exists_gate_gauge_sub_mem_of_path hU (D ^ 4) u v
      (fun q ↦ ⟨D' q, V q, hV q, hS q⟩) p hW
    obtain ⟨δ, hδ, hball⟩ := Metric.eventually_nhds_iff.mp hev
    refine ⟨δ, hδ, fun q hq ↦ ?_⟩
    obtain ⟨x, y, hxy⟩ := hball hq
    refine ⟨x, y, ?_⟩
    have := mem_ball_zero_iff.mp (Set.mem_preimage.mp hxy)
    rwa [hsq_sub, hsq_mul] at this
  -- The path lifting gives continuous gauged gates.
  obtain ⟨w, hw, hwu⟩ :=
    Matrix.exists_continuous_lift_of_continuous_mod_localUnitary (fun p ↦ sq (u p)) hunit hmod
  choose x y hxy using hwu
  let uh : unitInterval → Matrix (Fin ℓ × Fin r) (Fin d' × Fin d') ℂ := fun p ↦
    Matrix.reindex (Equiv.refl _) e.symm (w p)
  have huh : ∀ p, uh p = ((x p : Matrix (Fin ℓ) (Fin ℓ) ℂ) ⊗ₖ (y p : Matrix (Fin r) (Fin r) ℂ)) *
      u p := fun p ↦ by
    change Matrix.reindex (Equiv.refl _) e.symm (w p) = _
    rw [hxy p, ← hsq_mul, hsq_inj]
  let vh : unitInterval → Matrix (Fin d' × Fin d') (Fin r × Fin ℓ) ℂ := fun p ↦
    v p * (star (y p : Matrix (Fin r) (Fin r) ℂ) ⊗ₖ star (x p : Matrix (Fin ℓ) (Fin ℓ) ℂ))
  have hSF : ∀ p, Nonempty (TwoSiteStandardFormData (blockTwo (V p)) (uh p) (vh p)) := fun p ↦ by
    rw [huh p]
    exact ⟨(hS p).some.ofGateGauges (x p) (y p)⟩
  have huhc : Continuous uh := hw.matrix_reindex _ _
  refine ⟨ℓ, r, uh, vh, hind, hℓr, huhc, ?_, fun p ↦ ⟨D' p, V p, hV p, hSF p⟩⟩
  -- Continuity of the gauged second gate.
  have hshift : ∀ (N : ℕ) [NeZero N], Continuous fun q ↦ twoSiteShiftedLayer (N := N) (vh q) := by
    intro N _
    have hcirc : (fun q ↦ twoSiteShiftedLayer (N := N) (vh q)) = fun q ↦
        Matrix.reindex (twoSitePairConfigEquiv _ N).symm (twoSitePairConfigEquiv _ N).symm
          (mpo (MPOTensor.blockTwo (MPOTensor.blockTensor (U q) (D ^ 4))) N) *
          (twoSiteUnshiftedLayer (N := N) (uh q))ᴴ := by
      funext q
      obtain ⟨Sq⟩ := hSF q
      rw [← mpo_blockTwo_eq_of_mpo_eq (hV q) N (Nat.pos_of_ne_zero (NeZero.ne N)),
        Sq.mpo_eq_shifted_mul_unshifted]
      rw [Matrix.mul_assoc, twoSiteUnshiftedLayer_mul_conjTranspose Sq.u_unitary.2,
        Matrix.mul_one]
    rw [hcirc]
    refine Continuous.matrix_mul ?_ ?_
    · exact ((continuous_mpo N).comp (continuous_blockTwo.comp
        ((continuous_blockTensor _).comp hU))).matrix_reindex _ _
    · refine Continuous.matrix_conjTranspose ?_
      refine continuous_matrix fun h j ↦ ?_
      exact continuous_finsetProd _ fun i _ ↦ (continuous_apply_apply _ _).comp huhc
  refine continuous_iff_continuousAt.mpr fun p ↦ continuousAt_of_twoSiteShiftedLayer ?_
    (hshift 2).continuousAt (hshift 3).continuousAt
  obtain ⟨Sp⟩ := hSF p
  intro h0
  have h1 : (vh p)ᴴ * vh p = 1 := Sp.v_unitary.1
  rw [h0, Matrix.mul_zero] at h1
  have := congrFun (congrFun h1 (0, 0)) (0, 0)
  simp at this

end MPOTensor
