import TNLean.MPS.MPU.GeneralIndexContinuity
import TNLean.MPS.MPU.RepresentativeIndexOperations
import TNLean.MPS.MPU.SimpleCanonicalRepresentative

/-!
# Standard forms of fixed gate dimensions along a path

Along a continuous path `p ↦ 𝒰(p)` of tensors generating matrix product
unitaries, block `k₀ = D⁴` sites. Every blocked tensor is simple, so it has a
standard form with gates `u(p) : ℂ^{d'} ⊗ ℂ^{d'} → ℂ^ℓ ⊗ ℂ^r` and
`v(p) : ℂ^r ⊗ ℂ^ℓ → ℂ^{d'} ⊗ ℂ^{d'}`, where `d' = d^{k₀}`. The dimensions `ℓ`
and `r` are independent of `p`. For a simple canonical representative they are
fixed by the index, `r = d' 2^{ind}` and `ℓ r = d'²`, and the index is constant
along the path.

This is the remark "the Index Theorem implies that `u(p)` and `v(p)` map between
tensor product spaces of fixed dimensions, independent of `p`" in the proof of
Corollary `coruvSF` of arXiv:1703.09188, lines 877--884.

## Main statements

* `MPOTensor.IsMPU.exists_standardForm_fixed_gateDims_of_path`: one pair of gate
  dimensions `ℓ`, `r` serves every point of the path.
-/

open scoped Kronecker

namespace MPOTensor

variable {d D : ℕ}

/-- For a simple canonical-form-II tensor, the right source rank is fixed by the
index: `ind V = log₂ (r / d)`.

Source: arXiv:1703.09188, the formulas following Definition `def:index`,
lines 686--688. -/
private theorem IsMPUCanonicalFormII.index_eq_logb_rightRank_div_of_isMPUSimple
    {V : MPOTensor d D} (hV : IsMPUCanonicalFormII V) (hS : IsMPUSimple V) :
    hV.index = Real.logb 2 ((r[V] : ℝ) / d) := by
  have hS₁ : IsMPUSimple (MPOTensor.blockTensor V 1) := by
    rw [blockTensor_one_eq_reindexPhysical]
    exact hS.reindexPhysical (Kraus.singleBlockEquiv d)
  rw [hV.index_eq_logb_rightRank_div (by omega) hS₁, blockTensor_one_eq_reindexPhysical,
    rightRank_reindexPhysical, pow_one]

/-- **Standard forms of fixed gate dimensions along a path.** Let `p ↦ 𝒰(p)` be a
continuous path of tensors generating matrix product unitaries, with positive
physical dimension. Block `k₀ = D⁴` sites. There are dimensions `ℓ` and `r` such
that, at every point `p`, the MPU generated by the blocked tensor has a standard
form with gates `u : ℂ^{d'} ⊗ ℂ^{d'} → ℂ^ℓ ⊗ ℂ^r` and `v : ℂ^r ⊗ ℂ^ℓ → ℂ^{d'} ⊗ ℂ^{d'}`:
some tensor `V` generates the same periodic operators as the blocked tensor at
every positive length, and its two-site block has standard-form data for `u`
and `v`. The dimensions are fixed by the index, `ind 𝒰(0) = log₂ (r / d')` and
`ℓ r = d'²`. The tensors `𝒰(p)` are not assumed to be in canonical form.

Source: arXiv:1703.09188, proof of Corollary `coruvSF`, lines 877--884 ("the
Index Theorem implies that `u(p)` and `v(p)` map between tensor product spaces of
fixed dimensions, independent of `p`"). -/
theorem IsMPU.exists_standardForm_fixed_gateDims_of_path [NeZero d]
    {U : unitInterval → MPOTensor d D} (hU : Continuous U) (hMPU : ∀ p, IsMPU (U p)) :
    ∃ ℓ r : ℕ, (∀ [NeZero D], (hMPU 0).index =
        Real.logb 2 ((r : ℝ) / (Kraus.blockPhysDim d (D ^ 4) : ℕ))) ∧
      ℓ * r = Kraus.blockPhysDim d (D ^ 4) * Kraus.blockPhysDim d (D ^ 4) ∧
      ∀ p, ∃ (D' : ℕ) (V : MPOTensor (Kraus.blockPhysDim d (D ^ 4)) D')
      (u : Matrix (Fin ℓ × Fin r)
        (Fin (Kraus.blockPhysDim d (D ^ 4)) × Fin (Kraus.blockPhysDim d (D ^ 4))) ℂ)
      (v : Matrix (Fin (Kraus.blockPhysDim d (D ^ 4)) ×
        Fin (Kraus.blockPhysDim d (D ^ 4))) (Fin r × Fin ℓ) ℂ),
      (∀ N : ℕ, 0 < N → mpo V N = mpo (MPOTensor.blockTensor (U p) (D ^ 4)) N) ∧
        Nonempty (TwoSiteStandardFormData (blockTwo V) u v) := by
  have : NeZero D := (hMPU 0).neZero_bond
  have hk : 0 < D ^ 4 := pow_pos (NeZero.pos D) 4
  set d' := Kraus.blockPhysDim d (D ^ 4)
  have : NeZero d' := ⟨by
    simp only [d', Kraus.blockPhysDim_eq_pow]
    exact pow_ne_zero _ (NeZero.ne d)⟩
  set I := (hMPU 0).index
  -- At each point, a standard form whose right rank is fixed by the index.
  have hpt : ∀ p, ∃ (ℓ' r' : ℕ) (D' : ℕ) (V : MPOTensor d' D')
      (u : Matrix (Fin ℓ' × Fin r') (Fin d' × Fin d') ℂ)
      (v : Matrix (Fin d' × Fin d') (Fin r' × Fin ℓ') ℂ),
      ((∀ N : ℕ, 0 < N → mpo V N = mpo (MPOTensor.blockTensor (U p) (D ^ 4)) N) ∧
        Nonempty (TwoSiteStandardFormData (blockTwo V) u v)) ∧
      I = Real.logb 2 ((r' : ℝ) / d') ∧ ℓ' * r' = d' * d' ∧ 0 < r' := by
    intro p
    obtain ⟨E, hE, V, hV, hsimple, -, hsame, ⟨S⟩⟩ :=
      ((hMPU p).blockTensor_pow_four_isMPUSimple).exists_reduced_twoSiteStandardFormData
    have : NeZero E := ⟨hE.ne'⟩
    have hind : I = hV.index := by
      change (hMPU 0).index = hV.index
      rw [IsMPU.index_const_of_continuous hU hMPU 0 p, ← (hMPU p).index_blockTensor (D ^ 4) hk]
      exact ((hMPU p).blockTensor (D ^ 4) hk).index_eq_canonical_representative hV hsame
    refine ⟨ℓ[V], r[V], E, V, _, _, ⟨hsame, ⟨S⟩⟩, ?_, ?_, S.right_pos⟩
    · rw [hind, hV.index_eq_logb_rightRank_div_of_isMPUSimple hsimple]
    · have := (hV.isMPUSimple_tfae.out 1 2).mp hsimple
      rw [mul_comm]
      exact this
  obtain ⟨L, R, -, -, -, -, -, hR₀, hLR₀, hR₀pos⟩ := hpt 0
  refine ⟨L, R, fun {_} ↦ hR₀, hLR₀, fun p ↦ ?_⟩
  obtain ⟨ℓ', r', D', V, u, v, hrep, hr', hℓr', hr'pos⟩ := hpt p
  have hd' : (0 : ℝ) < d' := by exact_mod_cast NeZero.pos d'
  have hr : r' = R := by
    have h := hr'.symm.trans hR₀
    have h' : ((r' : ℝ) / d') = (R : ℝ) / d' :=
      Real.logb_injOn_pos (by norm_num : (1 : ℝ) < 2)
        (div_pos (by exact_mod_cast hr'pos) hd') (div_pos (by exact_mod_cast hR₀pos) hd') h
    have : (r' : ℝ) = R := by
      field_simp at h'
      exact h'
    exact_mod_cast this
  subst hr
  have hℓ : ℓ' = L := Nat.eq_of_mul_eq_mul_right hr'pos (hℓr'.trans hLR₀.symm)
  subst hℓ
  exact ⟨D', V, u, v, hrep⟩

end MPOTensor
