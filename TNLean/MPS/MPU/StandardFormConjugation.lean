import TNLean.MPS.MPU.ConjugationSymmetry
import TNLean.MPS.MPU.EvenFamilySourceGauges
import TNLean.MPS.MPU.SourceFactorsStandardForm

/-!
# Conjugation symmetry of a matrix product unitary in standard form

Proposition `prop1conj` of arXiv:1703.09188 (lines 1008--1027) concerns "the
MPU generated by a tensor in SF". Following
`docs/paper-gaps/mpu_standard_form_canonical_convention.tex`, that tensor is the
two-site block `𝒱₂` of a tensor `𝒱`, and the invariance hypothesis
`∀ N, U⁽ᴺ⁾ = conj U⁽ᴺ⁾` of lines 1008--1009 is read for `mpo (blockTwo 𝒱) N`
at every positive length `N` of the two-spin standard-form chain. Unlike
Proposition `PropChiral` (line 1217), the source does not restrict to even `N`.

The "if" direction holds for every standard form of a two-site block: the
local equations alone imply the invariance, without a canonical form or
symmetry type. For the "only if" direction the standard form is that of a
simple tensor in canonical form II (Definition `SF`, lines 617--622), with
gates built from source factors normalized at its fixed point. Invariance at
every positive standard-form length is invariance of `mpo 𝒱 N` at every even
`N > 1`. The even-family Fundamental Theorem then compares the source factors
of `𝒱` with their entrywise conjugates. Its possible unblocked sign cancels in
both gates, so no invariance at odd original lengths is needed.

## Main results

* `MPOTensor.TwoSiteStandardFormData.blockTwo_mpo_conjugation_invariant_of_local`.
* `MPOTensor.mpo_even_eq_of_blockTwo_mpo_eq`, `MPOTensor.mpo_even_eq_map_star_of_blockTwo`.
* `MPOTensor.IsMPUCanonicalFormII.exists_local_conjugation_gauges_of_even`.
* `MPOTensor.IsMPUCanonicalFormII.standardForm_conjugation_iff`: Proposition
  `prop1conj`.
-/

open scoped Matrix Kronecker

namespace MPOTensor

variable {d D ℓ r : ℕ}

/-- **Local sufficiency in `prop1conj`.** Let `u, v` be the gates of a standard
form of the two-site block of `𝒱`. If unitaries `x, y` satisfy
`conj(u) = (x ⊗ y) u` and `conj(v) = v (y† ⊗ x†)`, then the MPU generated by
the standard form is fixed by complex conjugation at every positive length of
the two-spin chain. Source: arXiv:1703.09188, Proposition `prop1conj`, "if"
direction (lines 1014--1027, proof at line 1030), with the length reading of
`docs/paper-gaps/mpu_standard_form_canonical_convention.tex`. -/
theorem TwoSiteStandardFormData.blockTwo_mpo_conjugation_invariant_of_local
    {V : MPOTensor d D}
    {u : Matrix (Fin ℓ × Fin r) (Fin d × Fin d) ℂ}
    {v : Matrix (Fin d × Fin d) (Fin r × Fin ℓ) ℂ}
    (S : TwoSiteStandardFormData (MPOTensor.blockTwo V) u v)
    (x : Matrix.unitaryGroup (Fin ℓ) ℂ) (y : Matrix.unitaryGroup (Fin r) ℂ)
    (hu : u.map (starRingEnd ℂ) =
      ((x : Matrix (Fin ℓ) (Fin ℓ) ℂ) ⊗ₖ (y : Matrix (Fin r) (Fin r) ℂ)) * u)
    (hv : v.map (starRingEnd ℂ) = v *
      ((y : Matrix (Fin r) (Fin r) ℂ)ᴴ ⊗ₖ (x : Matrix (Fin ℓ) (Fin ℓ) ℂ)ᴴ)) :
    ∀ N : ℕ, 0 < N →
      mpo (MPOTensor.blockTwo V) N = (mpo (MPOTensor.blockTwo V) N).map (starRingEnd ℂ) := by
  intro N hN
  have : NeZero N := ⟨hN.ne'⟩
  exact (S.map_star_mpo_eq_of_gate_conjugation x y hu
    (by simpa only [Matrix.star_eq_conjTranspose] using hv)).symm

/-- Equal standard-form chains at every positive length are equal even
original chains. Source: arXiv:1703.09188, Definition `SF`, lines 617--622,
with the length reading of
`docs/paper-gaps/mpu_standard_form_canonical_convention.tex`. -/
theorem mpo_even_eq_of_blockTwo_mpo_eq {U V : MPOTensor d D}
    (h : ∀ N : ℕ, 0 < N → mpo (MPOTensor.blockTwo U) N = mpo (MPOTensor.blockTwo V) N) :
    ∀ N : ℕ, 1 < N → Even N → mpo U N = mpo V N := by
  rintro N hN ⟨M, rfl⟩
  have hM := h M (by omega)
  rw [mpo_blockTwo_eq_reindex_blockTensor, mpo_blockTwo_eq_reindex_blockTensor,
    mpo_blockTensor_eq_reindex, mpo_blockTensor_eq_reindex] at hM
  have h' := (Matrix.reindex _ _).injective ((Matrix.reindex _ _).injective hM)
  rw [show M + M = M * 2 by ring]
  exact h'

/-- Two-site blocking commutes with entrywise conjugation. -/
theorem blockTwo_mapStar (U : MPOTensor d D) :
    MPOTensor.blockTwo (MPOTensor.mapStar U) = MPOTensor.mapStar (MPOTensor.blockTwo U) := by
  funext i j
  simp [MPOTensor.blockTwo, MPOTensor.mapStar, Matrix.map_mul]

/-- Conjugation invariance of the standard-form chain at every positive length
is conjugation invariance of the original chain at every even length `N > 1`.
Source: arXiv:1703.09188, `prop1conj`, lines 1008--1009, with the length
reading of `docs/paper-gaps/mpu_standard_form_canonical_convention.tex`. -/
theorem mpo_even_eq_map_star_of_blockTwo {V : MPOTensor d D}
    (hconj : ∀ N : ℕ, 0 < N →
      mpo (MPOTensor.blockTwo V) N = (mpo (MPOTensor.blockTwo V) N).map (starRingEnd ℂ)) :
    ∀ N : ℕ, 1 < N → Even N → mpo V N = (mpo V N).map (starRingEnd ℂ) := by
  have h := mpo_even_eq_of_blockTwo_mpo_eq (U := V) (V := MPOTensor.mapStar V)
    (fun N hN ↦ by rw [blockTwo_mapStar, mpo_map_star]; exact hconj N hN)
  intro N hN he
  conv_lhs => rw [h N hN he]
  rw [mpo_map_star]

/-- **Forward conjugation equations from even chains.** If `U⁽ᴺ⁾` of a tensor
in canonical form II is fixed by entrywise conjugation at every even `N > 1`,
then the supplied source gates satisfy `conj(u) = (x ⊗ y) u` and
`conj(v) = v (y† ⊗ x†)` for unitaries `x, y`. Source: arXiv:1703.09188,
`prop1conj`, "only if" direction, lines 1030--1033, with the even-family
Fundamental Theorem in place of `FundamentalMPU`. -/
theorem IsMPUCanonicalFormII.exists_local_conjugation_gauges_of_even
    {U : MPOTensor d D} (hU : IsMPUCanonicalFormII U)
    {ρ : Matrix (Fin D) (Fin D) ℂ} (S : SourceFactors U ρ)
    (huS : (SourceFactors.sourceU U S).IsUnitaryBetween)
    (hconj : ∀ N : ℕ, 1 < N → Even N → mpo U N = (mpo U N).map (starRingEnd ℂ)) :
    ∃ (x : Matrix.unitaryGroup (Fin ℓ[U]) ℂ) (y : Matrix.unitaryGroup (Fin r[U]) ℂ),
      (SourceFactors.sourceU U S).map (starRingEnd ℂ) =
        ((x : Matrix (Fin ℓ[U]) (Fin ℓ[U]) ℂ) ⊗ₖ (y : Matrix (Fin r[U]) (Fin r[U]) ℂ)) *
          SourceFactors.sourceU U S ∧
      (SourceFactors.sourceV U S).map (starRingEnd ℂ) =
        SourceFactors.sourceV U S *
          (star (y : Matrix (Fin r[U]) (Fin r[U]) ℂ) ⊗ₖ
            star (x : Matrix (Fin ℓ[U]) (Fin ℓ[U]) ℂ)) := by
  obtain ⟨hr, hl, x, y, hu, hv⟩ :=
    hU.exists_supplied_source_gate_unitary_gauges_of_mpo_eq_even hU.mapStar S S.mapStar huS
      (S.sourceU_mapStar_isUnitaryBetween huS)
      (by intro N hN heven; rw [mpo_map_star]; exact hconj N hN heven)
  exact S.exists_local_conjugation_gauges_of_gate_gauges hr hl x y hu hv

/-- Both source ranks of a canonical-form-II tensor with unitary gate are
nonzero. -/
theorem IsMPUCanonicalFormII.nonempty_source_ranks {U : MPOTensor d D}
    (hU : IsMPUCanonicalFormII U) {ρ : Matrix (Fin D) (Fin D) ℂ} (S : SourceFactors U ρ)
    (huS : (SourceFactors.sourceU U S).IsUnitaryBetween) :
    Nonempty (Fin ℓ[U]) ∧ Nonempty (Fin r[U]) := by
  let : NeZero d := hU.neZero_phys
  have hpos : 0 < Fintype.card (Fin ℓ[U] × Fin r[U]) :=
    lt_of_lt_of_le (by simpa using Nat.mul_pos (NeZero.pos d) (NeZero.pos d))
      (huS.1.card_le _)
  obtain ⟨l, r⟩ := Fintype.card_pos_iff.mp hpos
  exact ⟨⟨l⟩, ⟨r⟩⟩

/-- **Conjugation symmetry in standard form.** Let `𝒱` be a simple tensor in
canonical form II and let `u, v` be the gates of source factors normalized at
its canonical fixed point, i.e. of a standard form of `𝒱₂`. The MPU generated
by the standard form satisfies `U⁽ᴺ⁾ = conj U⁽ᴺ⁾` at every positive length of
the two-spin chain if and only if there are unitaries `x, y`, both symmetric
or both skew-symmetric, with `conj(u) = (x ⊗ y) u` and
`conj(v) = v (y† ⊗ x†)`.

Source: arXiv:1703.09188, Proposition `prop1conj`, lines 1008--1039, with the
reading of a tensor in standard form and of its lengths in
`docs/paper-gaps/mpu_standard_form_canonical_convention.tex`. -/
theorem IsMPUCanonicalFormII.standardForm_conjugation_iff
    {V : MPOTensor d D} (hV : IsMPUCanonicalFormII V) (hsimple : IsMPUSimple V)
    (S : SourceFactors V hV.ρ) :
    (∀ N : ℕ, 0 < N →
        mpo (MPOTensor.blockTwo V) N = (mpo (MPOTensor.blockTwo V) N).map (starRingEnd ℂ)) ↔
      ∃ (x : Matrix.unitaryGroup (Fin ℓ[V]) ℂ) (y : Matrix.unitaryGroup (Fin r[V]) ℂ),
        (((x : Matrix (Fin ℓ[V]) (Fin ℓ[V]) ℂ)ᵀ = x ∧
            (y : Matrix (Fin r[V]) (Fin r[V]) ℂ)ᵀ = y) ∨
          ((x : Matrix (Fin ℓ[V]) (Fin ℓ[V]) ℂ)ᵀ = -x ∧
            (y : Matrix (Fin r[V]) (Fin r[V]) ℂ)ᵀ = -y)) ∧
        (SourceFactors.sourceU V S).map (starRingEnd ℂ) =
          ((x : Matrix (Fin ℓ[V]) (Fin ℓ[V]) ℂ) ⊗ₖ (y : Matrix (Fin r[V]) (Fin r[V]) ℂ)) *
            SourceFactors.sourceU V S ∧
        (SourceFactors.sourceV V S).map (starRingEnd ℂ) =
          SourceFactors.sourceV V S *
            ((y : Matrix (Fin r[V]) (Fin r[V]) ℂ)ᴴ ⊗ₖ
              (x : Matrix (Fin ℓ[V]) (Fin ℓ[V]) ℂ)ᴴ) := by
  have huS := hV.sourceFactors_sourceU_isUnitaryBetween hsimple S
  constructor
  · intro hconj
    have heven := mpo_even_eq_map_star_of_blockTwo hconj
    obtain ⟨hl, hr⟩ := hV.nonempty_source_ranks S huS
    obtain ⟨x, y, hu, hv⟩ := hV.exists_local_conjugation_gauges_of_even S huS heven
    refine ⟨x, y, Matrix.transpose_eq_self_or_transpose_eq_neg_of_gate_conjugation
      x.property y.property huS.2 hu, hu, ?_⟩
    simpa only [Matrix.star_eq_conjTranspose] using hv
  · rintro ⟨x, y, -, hu, hv⟩
    obtain ⟨T⟩ := hV.exists_twoSiteStandardFormData_sourceFactors hsimple S
    exact T.blockTwo_mpo_conjugation_invariant_of_local x y hu hv

end MPOTensor
