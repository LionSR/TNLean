import TNLean.MPS.AreaLaw.Huang.GaussianQuadrature
import QICLean.Analysis.UnitaryEvolution

/-!
# Gaussian quadrature of a Hermitian propagator

The actual unitary path generated by a Hermitian matrix is Lipschitz in time with constant
equal to the generator norm. Consequently, the Gaussian spectral filter has a finite
positive quadrature with an explicit error and sample count. Applied to a generator shifted
by an energy estimate, this is the discretization in Huang, arXiv:1406.6355v6, Section 5.4,
equations (19) and (22). A global matrix product approximation to each sample remains a
separate theorem.
-/

open Matrix MeasureTheory ProbabilityTheory
open scoped BigOperators Matrix.Norms.L2Operator NNReal

namespace TNLean.MPS.AreaLaw

private theorem hermitianUnitaryPath_zero_generator
    {n : Type*} [Fintype n] [DecidableEq n] (t : ℝ) :
    hermitianUnitaryPath (0 : Matrix n n ℂ) t = 1 := by
  simp [hermitianUnitaryPath]

/-- Hermitian time evolution is Lipschitz in time with the generator norm as constant.
Huang, arXiv:1406.6355v6, Section 5.4, the discretization estimate after equation (22). -/
theorem norm_hermitianUnitaryPath_sub_time_le
    {n : Type*} [Fintype n] [DecidableEq n] {H : Matrix n n ℂ} (hH : H.IsHermitian)
    (s t : ℝ) :
    ‖hermitianUnitaryPath H t - hermitianUnitaryPath H s‖ ≤ ‖H‖ * |t - s| := by
  have heq : hermitianUnitaryPath H t - hermitianUnitaryPath H s =
      (hermitianUnitaryPath H (t - s) - 1) * hermitianUnitaryPath H s := by
    rw [sub_mul, one_mul, ← hermitianUnitaryPath_add, sub_add_cancel]
  rw [heq, CStarRing.norm_mul_mem_unitary _ (SpectralFilter.hermitianUnitaryPath_mem_unitary hH s)]
  simpa only [hermitianUnitaryPath_zero_generator, sub_zero] using
    Matrix.norm_hermitianUnitaryPath_sub_le hH isHermitian_zero (t - s)

/-- The Gaussian spectral filter is approximated by its actual propagator samples, with
positive interval weights and mesh error at most `epsilon`. The number of samples is at most
`2 T (‖H‖ + 1) / epsilon + 2`. Huang, Section 5.4, Lemma 19 and equation (22).
No matrix product operator approximation is a hypothesis. -/
theorem norm_gaussianIntertwiner_sub_unitary_timeMesh_sum_le
    {n : Type*} [Fintype n] [DecidableEq n] [Nonempty n]
    (h : ℝ≥0) {H : Matrix n n ℂ} (hH : H.IsHermitian)
    {T epsilon : ℝ} (hT : 0 ≤ T) (hepsilon : 0 < epsilon) :
    ‖GaussianFilter.gaussianIntertwiner h H 0 1 -
      ∑ j, timeMeshWeight h T (epsilon / (‖H‖ + 1)) j •
        hermitianUnitaryPath H (timeMeshNode T (epsilon / (‖H‖ + 1)) j)‖ ≤
      2 * Real.exp (-T ^ 2 / (2 * (h : ℝ))) + epsilon := by
  have hf : Integrable (hermitianUnitaryPath H) (gaussianReal 0 h) := by
    simpa only [hermitianUnitaryPath_zero_generator, mul_one] using
      GaussianFilter.integrable_intertwinerIntegrand h hH isHermitian_zero 1
  have hnorm (t : ℝ) : ‖hermitianUnitaryPath H t‖ ≤ 1 :=
    (CStarRing.norm_of_mem_unitary (SpectralFilter.hermitianUnitaryPath_mem_unitary hH t)).le
  have heq : GaussianFilter.gaussianIntertwiner h H 0 1 =
      ∫ t, hermitianUnitaryPath H t ∂gaussianReal 0 h := by
    simp only [GaussianFilter.gaussianIntertwiner, hermitianUnitaryPath_zero_generator, mul_one]
  rw [heq]
  exact norm_integral_sub_timeMesh_accuracy_sum_le h hT (norm_nonneg H) hepsilon _ hf hnorm
    (fun t _ s _ ↦ norm_hermitianUnitaryPath_sub_time_le hH s t)

end TNLean.MPS.AreaLaw
