import TNLean.Circuit.ProjectedRelativeEvolution
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Data.List.OfFn

/-!
# Products of evolutions on disjoint regions

Localized interaction-picture generators on disjoint regions have unitary evolutions
whose ordered product is generated by their sum. This is the analytic assembly used in
the block approximation of one-dimensional evolution in Osborne,
arXiv:quant-ph/0508031v2, and Huang, arXiv:1406.6355v6, Section 5.4.

The statements below concern supplied regions and their projected generators. Chain
partitions, Lieb–Robinson localization estimates and matrix product operator bond bounds
are separate requirements of the global propagator approximation.
-/

open scoped BigOperators Matrix Matrix.Norms.L2Operator

namespace MatrixEvolution

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The ordered product of differentiable evolution paths is generated by the sum when
each factor commutes with the other generators. This is the elementary product rule
used in the block-evolution argument of Osborne, arXiv:quant-ph/0508031v2. -/
theorem hasDerivAt_ordered_prod_of_commute {m : ℕ}
    (U G : Fin m → ℝ → Matrix n n ℂ) (t : ℝ)
    (hU : ∀ j, HasDerivAt (U j) ((Complex.I • G j t) * U j t) t)
    (hcomm : ∀ j k, j ≠ k → Commute (U j t) (G k t)) :
    HasDerivAt (fun s ↦ (List.ofFn fun j ↦ U j s).prod)
      ((Complex.I • ∑ j, G j t) * (List.ofFn fun j ↦ U j t).prod) t := by
  induction m with
  | zero => simpa using hasDerivAt_const t (1 : Matrix n n ℂ)
  | succ m ih =>
    have htail := ih (fun j ↦ U j.succ) (fun j ↦ G j.succ)
      (fun j ↦ hU j.succ) (fun j k hjk ↦ hcomm j.succ k.succ (by simpa using hjk))
    have hc : Commute (U 0 t) (Complex.I • ∑ j : Fin m, G j.succ t) :=
      (Commute.sum_right Finset.univ (fun j : Fin m ↦ G j.succ t) (U 0 t)
        (fun j _ ↦ hcomm 0 j.succ (Fin.succ_ne_zero j).symm)).smul_right Complex.I
    convert (hU 0).mul htail using 1
    · funext s
      simp only [List.ofFn_succ, List.prod_cons, Pi.mul_apply]
    · simp only [List.ofFn_succ, List.prod_cons, Fin.sum_univ_succ, smul_add, add_mul]
      rw [mul_assoc, ← mul_assoc (U 0 t), hc.eq, mul_assoc]

end MatrixEvolution

namespace QuantumCircuit

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Construct the evolutions of projected interaction-picture terms on disjoint regions.
Their single ordered product approximates the relative evolution for the sum of the
terms, with error at most the sum of the generator errors times elapsed time.

This is an auxiliary assembly statement for Osborne, arXiv:quant-ph/0508031v2,
equations (2)–(13), and Huang, arXiv:1406.6355v6, Section 5.4. The hypotheses do not yet
choose a chain partition or prove its generator localization estimates. -/
theorem exists_disjoint_projected_propagator_approximation (q : ℕ) [NeZero q] {m : ℕ}
    (K : Fin m → Finset ι)
    (hK : Pairwise fun j k ↦ Disjoint (K j : Set ι) (K k : Set ι))
    {A : Matrix (ι → Fin q) (ι → Fin q) ℂ} (hA : A.IsHermitian)
    (B : Fin m → Matrix (ι → Fin q) (ι → Fin q) ℂ)
    (hB : ∀ j, (B j).IsHermitian) :
    ∃ U : Fin m → ℝ → Matrix (ι → Fin q) (ι → Fin q) ℂ,
      (∀ j, U j 0 = 1) ∧
      (∀ j t, HasDerivAt (U j)
        ((Complex.I • siteExpectation q (K j) (heisenbergEvolution A t (B j))) * U j t) t) ∧
      (∀ j t, U j t ∈ Matrix.unitaryGroup (ι → Fin q) ℂ) ∧
      (∀ j t, U j t ∈ supportedOperators q (K j : Set ι)) ∧
      ∀ (t : ℝ) (ε : Fin m → ℝ),
        (∀ j s, s ∈ Set.uIcc 0 t →
          ‖heisenbergEvolution A s (B j) -
            siteExpectation q (K j) (heisenbergEvolution A s (B j))‖ ≤ ε j) →
        ‖Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-t) -
            Matrix.hermitianUnitaryPath A (-t) *
              (List.ofFn fun j ↦ U j t).prod‖ ≤ (∑ j, ε j) * |t| := by
  classical
  have hlocal (j : Fin m) :
      ∃ U : ℝ → Matrix (ι → Fin q) (ι → Fin q) ℂ, U 0 = 1 ∧
        (∀ t, HasDerivAt U
          ((Complex.I • siteExpectation q (K j) (heisenbergEvolution A t (B j))) * U t) t) ∧
        (∀ t, U t ∈ Matrix.unitaryGroup (ι → Fin q) ℂ) ∧
        (∀ t, U t ∈ supportedOperators q (K j : Set ι)) := by
    obtain ⟨U, h0, hd, hu, hs, -, -⟩ :=
      exists_supported_projected_relative_evolution q (K j) hA (hA.sub (hB j))
    have hcancel : A - (A - B j) = B j := by abel
    exact ⟨U, h0, by simpa only [hcancel] using hd, hu, hs⟩
  choose U hU0 hUd hUunit hUsupport using hlocal
  refine ⟨U, hU0, hUd, hUunit, hUsupport, ?_⟩
  intro t ε herror
  let G : ℝ → Matrix (ι → Fin q) (ι → Fin q) ℂ :=
    fun s ↦ heisenbergEvolution A s (∑ j, B j)
  let F : ℝ → Matrix (ι → Fin q) (ι → Fin q) ℂ :=
    fun s ↦ ∑ j, siteExpectation q (K j) (heisenbergEvolution A s (B j))
  have hBsum : (∑ j, B j).IsHermitian := Matrix.isHermitian_sum _ fun j _ ↦ hB j
  have hGc : Continuous G :=
    (MatrixEvolution.contDiff_projectedGenerator LinearMap.id A (∑ j, B j) 1).continuous
  have hFc : Continuous F := continuous_finsetSum _ fun j _ ↦
    (MatrixEvolution.contDiff_projectedGenerator (siteExpectationLM q (K j)) A (B j) 1).continuous
  have hGh (s : ℝ) : (G s).IsHermitian :=
    MatrixEvolution.isHermitian_projectedGenerator LinearMap.id (fun _ h ↦ h) hA hBsum s
  have hFh (s : ℝ) : (F s).IsHermitian := Matrix.isHermitian_sum _ fun j _ ↦
    MatrixEvolution.isHermitian_projectedGenerator (siteExpectationLM q (K j))
      (fun _ h ↦ isHermitian_siteExpectation (K j) h) hA (hB j) s
  have hproduct (s : ℝ) :
      HasDerivAt (fun s ↦ (List.ofFn fun j ↦ U j s).prod)
        ((Complex.I • F s) * (List.ofFn fun j ↦ U j s).prod) s :=
    MatrixEvolution.hasDerivAt_ordered_prod_of_commute U
      (fun j s ↦ siteExpectation q (K j) (heisenbergEvolution A s (B j))) s
      (fun j ↦ hUd j s) (fun j k hjk ↦
        commute_of_mem_supportedOperators (hK hjk) (hUsupport j s)
          (siteExpectation_mem_supportedOperators (K k) _))
  have hrelative (s : ℝ) :
      HasDerivAt (fun s ↦ Matrix.hermitianUnitaryPath A s *
        Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-s))
        ((Complex.I • G s) * (Matrix.hermitianUnitaryPath A s *
          Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-s))) s := by
    have hcancel : A - (A - ∑ j, B j) = ∑ j, B j := by abel
    simpa only [hcancel, G, heisenbergEvolution_eq_hermitianUnitaryPath] using
      MatrixEvolution.hasDerivAt_hermitianUnitaryPath_mul_neg A (A - ∑ j, B j) s
  have hcompare := MatrixEvolution.norm_sub_le_of_generator_bound hGc hFc hGh hFh
    (by simp) (by simp [hU0]) hrelative hproduct t (∑ j, ε j) (fun s hs ↦ by
      change ‖Matrix.hermitianUnitaryPath A s * (∑ j, B j) *
          Matrix.hermitianUnitaryPath A (-s) -
          ∑ j, siteExpectation q (K j) (heisenbergEvolution A s (B j))‖ ≤ _
      rw [Finset.mul_sum, Finset.sum_mul, ← Finset.sum_sub_distrib]
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ ↦ herror j s hs))
  calc
    _ = ‖Matrix.hermitianUnitaryPath A t *
        (Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-t) -
          Matrix.hermitianUnitaryPath A (-t) * (List.ofFn fun j ↦ U j t).prod)‖ :=
      (CStarRing.norm_mem_unitary_mul _
        (SpectralFilter.hermitianUnitaryPath_mem_unitary hA t)).symm
    _ = ‖Matrix.hermitianUnitaryPath A t *
        Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-t) -
        (List.ofFn fun j ↦ U j t).prod‖ := by
      rw [mul_sub, ← mul_assoc, SpectralFilter.hermitianUnitaryPath_mul_neg, one_mul]
    _ ≤ _ := hcompare

end QuantumCircuit
