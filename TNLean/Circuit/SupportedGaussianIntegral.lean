import TNLean.Circuit.ProjectedRelativeEvolution
import QICLean.Analysis.GaussianFilter.MatrixIntegral

/-!
# Supported Gaussian averaging from projection bounds

For two Hermitian operators, construct the unitary evolution generated by the
projection of their relative-evolution generator onto a fixed region.
Localize an evolved observable onto a second region and average its product
with that unitary path against the restricted Gaussian measure.

If the observable and generator projection errors on `[-T, T]` are at most
`‖W‖ * εobs` and `εgen`, respectively, then the average differs from the
original truncated intertwiner by at most `‖W‖ * (εobs + T * εgen)`.
It is supported in any region containing both projection regions and has
norm at most `‖W‖`. The same path works for every observable, variance,
time cutoff and error bound.

Source: OpenAI, *Polynomial PEPS approximation of gapped square-grid ground states*,
Section 2, `eq:info-local-two-sided`, lines 513–562; TNLean one-dimensional note,
`part2a_mps_information.tex`,
lines 381–402. The locality estimates and physical Hamiltonians are supplied
by each application.
-/

open MeasureTheory ProbabilityTheory
open scoped Matrix Matrix.Norms.L2Operator NNReal

namespace QuantumCircuit

/-- Supported Gaussian averaging from actual observable and generator projection bounds.
The unitary path is constructed before the observable, variance, cutoff and error bounds.
Source: polynomial-PEPS, Section 2, eq:info-local-two-sided, lines 513–562;
one-dimensional note, part2a_mps_information.tex, lines 381–402. -/
theorem exists_supported_gaussian_integral_of_projection_bounds
    {ι : Type*} [Fintype ι] [DecidableEq ι] (q : ℕ) [NeZero q]
    {K' K : Matrix (ι → Fin q) (ι → Fin q) ℂ}
    (hK' : K'.IsHermitian) (hK : K.IsHermitian) (Bgen : Finset ι) :
    ∃ U : ℝ → Matrix (ι → Fin q) (ι → Fin q) ℂ,
      U 0 = 1 ∧
      (∀ t, HasDerivAt U
        ((Complex.I • siteExpectation q Bgen
          (heisenbergEvolution K' t (K' - K))) * U t) t) ∧
      (∀ t, U t ∈ Matrix.unitaryGroup (ι → Fin q) ℂ) ∧
      (∀ t, U t ∈ supportedOperators q (Bgen : Set ι)) ∧
      ∀ (Bobs Bout : Finset ι), Bobs ⊆ Bout → Bgen ⊆ Bout →
      ∀ (W : Matrix (ι → Fin q) (ι → Fin q) ℂ) (η : ℝ≥0) (T : ℝ),
        0 ≤ T →
        ∀ εobs εgen : ℝ, 0 ≤ εobs → 0 ≤ εgen →
        (∀ t : ℝ, |t| ≤ T →
          ‖heisenbergEvolution K' t W -
            siteExpectation q Bobs (heisenbergEvolution K' t W)‖ ≤ ‖W‖ * εobs) →
        (∀ t : ℝ, |t| ≤ T →
          ‖heisenbergEvolution K' t (K' - K) -
            siteExpectation q Bgen (heisenbergEvolution K' t (K' - K))‖ ≤ εgen) →
        let M := ∫ t : ℝ in Set.Icc (-T) T,
          siteExpectation q Bobs (heisenbergEvolution K' t W) * U t
            ∂ProbabilityTheory.gaussianReal 0 η
        M ∈ supportedOperators q (Bout : Set ι) ∧
        ‖M‖ ≤ ‖W‖ ∧
        ‖M - GaussianFilter.gaussianIntertwinerTruncated η T K' K W‖ ≤
          ‖W‖ * (εobs + T * εgen) := by
  classical
  obtain ⟨U, hU0, hU, hunit, hsupport, _, hcompare⟩ :=
    exists_supported_projected_relative_evolution q Bgen hK' hK
  refine ⟨U, hU0, hU, hunit, hsupport, ?_⟩
  intro Bobs Bout hobsSub hgenSub W η T hT εobs εgen hεobs hεgen hobs hgen M
  have hrelative (t : ℝ) (ht : |t| ≤ T) :
      ‖Matrix.hermitianUnitaryPath K' t * Matrix.hermitianUnitaryPath K (-t) - U t‖ ≤
        εgen * |t| :=
    hcompare t _ (fun s hs ↦ hgen s
      ((show |s| ≤ |t| by
        simpa only [sub_zero] using Set.abs_sub_left_of_mem_uIcc hs).trans ht))
  have hfactor (t : ℝ) :
      heisenbergEvolution K' t W *
          (Matrix.hermitianUnitaryPath K' t * Matrix.hermitianUnitaryPath K (-t)) =
        Matrix.hermitianUnitaryPath K' t * W * Matrix.hermitianUnitaryPath K (-t) := by
    rw [heisenbergEvolution_eq_hermitianUnitaryPath,
      Matrix.mul_assoc (Matrix.hermitianUnitaryPath K' t * W),
      ← Matrix.mul_assoc (Matrix.hermitianUnitaryPath K' (-t))
        (Matrix.hermitianUnitaryPath K' t),
      ← Matrix.hermitianUnitaryPath_add, neg_add_cancel,
      Matrix.hermitianUnitaryPath_zero, Matrix.one_mul]
  have hpoint (t : ℝ) (ht : |t| ≤ T) :
      ‖siteExpectation q Bobs (heisenbergEvolution K' t W) * U t -
        Matrix.hermitianUnitaryPath K' t * W * Matrix.hermitianUnitaryPath K (-t)‖ ≤
          ‖W‖ * (εobs + T * εgen) := by
    refine (hfactor t) ▸ (norm_sub_le_norm_sub_add_norm_sub
      (siteExpectation q Bobs (heisenbergEvolution K' t W) * U t)
      (heisenbergEvolution K' t W * U t)
      (heisenbergEvolution K' t W *
        (Matrix.hermitianUnitaryPath K' t * Matrix.hermitianUnitaryPath K (-t)))).trans ?_
    rw [← sub_mul, ← mul_sub, CStarRing.norm_mul_mem_unitary _ (hunit t),
      norm_sub_rev (siteExpectation q Bobs (heisenbergEvolution K' t W))
        (heisenbergEvolution K' t W)]
    refine (add_le_add (hobs t ht)
      (norm_mul_le_of_le
        (show ‖heisenbergEvolution K' t W‖ ≤ ‖W‖ from
          (SpectralFilter.norm_hermitianUnitaryPath_conj hK' W t).le)
        ((norm_sub_rev (U t)
          (Matrix.hermitianUnitaryPath K' t * Matrix.hermitianUnitaryPath K (-t))).trans_le
            (hrelative t ht)))).trans ?_
    nlinarith [mul_le_mul_of_nonneg_left ht (mul_nonneg (norm_nonneg W) hεgen)]
  let f := fun t : ℝ ↦ siteExpectation q Bobs (heisenbergEvolution K' t W) * U t
  have hnorm (t : ℝ) : ‖f t‖ ≤ ‖W‖ :=
    (CStarRing.norm_mul_mem_unitary _ (hunit t)).trans_le
      (MatrixEvolution.norm_projectedGenerator_le (siteExpectationLM q Bobs)
        (norm_siteExpectation_le Bobs) hK' W t)
  have hcont : Continuous f :=
    (MatrixEvolution.contDiff_projectedGenerator (siteExpectationLM q Bobs)
      K' W 0).continuous.mul
      (show Differentiable ℝ U from fun t ↦ (hU t).differentiableAt).continuous
  have hint : Integrable f (gaussianReal 0 η) :=
    (integrable_const ‖W‖).mono' hcont.aestronglyMeasurable
      (Filter.Eventually.of_forall hnorm)
  have hfix (t : ℝ) : siteExpectation q Bout (f t) = f t :=
    siteExpectation_of_mem_supportedOperators Bout (mul_mem_supportedOperators
      (supportedOperators_mono (Finset.coe_subset.mpr hobsSub)
        (siteExpectation_mem_supportedOperators Bobs _))
      (supportedOperators_mono (Finset.coe_subset.mpr hgenSub) (hsupport t)))
  have hMint : siteExpectation q Bout M = M :=
    ((siteExpectationLM q Bout).toContinuousLinearMap.integral_comp_comm
      (hint.restrict (s := Set.Icc (-T) T))).symm.trans
      (integral_congr_ae (Filter.Eventually.of_forall hfix))
  refine ⟨hMint ▸ siteExpectation_mem_supportedOperators Bout _, ?_, ?_⟩
  · exact (norm_setIntegral_le_of_norm_le_const (measure_lt_top _ _)
      (fun t _ ↦ hnorm t)).trans
        (mul_le_of_le_one_right (norm_nonneg W) measureReal_le_one)
  · change ‖(∫ t : ℝ in Set.Icc (-T) T, f t ∂gaussianReal 0 η) -
      GaussianFilter.gaussianIntertwinerTruncated η T K' K W‖ ≤ _
    rw [GaussianFilter.gaussianIntertwinerTruncated,
      ← integral_sub (hint.restrict (s := Set.Icc (-T) T))
        (GaussianFilter.integrable_intertwinerIntegrand_restrict η T hK' hK W)]
    exact (norm_setIntegral_le_of_norm_le_const (measure_lt_top _ _)
      (fun t ht ↦ hpoint t (abs_le.mpr ht))).trans
        (mul_le_of_le_one_right (by positivity) measureReal_le_one)

end QuantumCircuit
