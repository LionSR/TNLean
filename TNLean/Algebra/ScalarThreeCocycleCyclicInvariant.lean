namespace TNLean.Algebra

namespace ScalarThreeCochain

variable {G : Type*} [Group G]

/-- The cyclic invariant `∏_{k < n} ω(g, g^k, g)` of a scalar three-cochain at an element `g`.
It is gauge invariant when `g ^ n = 1` (`cyclicInvariant_fusionGauge`). -/
def cyclicInvariant (ω : ScalarThreeCochain G) (g : G) (n : ℕ) : Units ℂ :=
  ∏ k ∈ Finset.range n, ω g (g ^ k) g

/-- The cyclic invariant of a three-coboundary is one: the factors
`β(g, g^{k+1}) / β(g, g^k)` and `β(g^k, g) / β(g^{k+1}, g)` telescope, and `g ^ n = 1` closes
both telescopes. No normalization of `β` is needed. -/
theorem cyclicInvariant_coboundary (β : ScalarCocycle G) {g : G} {n : ℕ} (hg : g ^ n = 1) :
    cyclicInvariant (coboundary β) g n = 1 := by
  have hterm : ∀ k : ℕ, coboundary β g (g ^ k) g =
      (β g (g ^ (k + 1)) / β g (g ^ k)) * (β (g ^ (k + 1)) g / β (g ^ k) g)⁻¹ := by
    intro k
    simp only [coboundary, div_eq_mul_inv, mul_inv_rev, inv_inv, ← pow_succ, ← pow_succ']
    simp only [mul_comm, mul_left_comm, mul_assoc]
  simp only [cyclicInvariant, hterm, Finset.prod_mul_distrib, Finset.prod_inv_distrib,
    Finset.prod_range_div (fun k ↦ β g (g ^ k)), Finset.prod_range_div (fun k ↦ β (g ^ k) g),
    hg, pow_zero, div_self', inv_one, mul_one]

/-- **Gauge invariance of the cyclic invariant.** If `g ^ n = 1`, every fusion-tensor gauge
`ω ↦ dβ · ω` of arXiv:2502.20257, `eq:omegagauge`, leaves `∏_{k < n} ω(g, g^k, g)` unchanged. -/
theorem cyclicInvariant_fusionGauge (β : ScalarCocycle G) (ω : ScalarThreeCochain G) {g : G}
    {n : ℕ} (hg : g ^ n = 1) :
    cyclicInvariant (fusionGauge β ω) g n = cyclicInvariant ω g n := by
  have h := cyclicInvariant_coboundary β hg
  simp only [cyclicInvariant, fusionGauge, Finset.prod_mul_distrib] at h ⊢
  rw [h, one_mul]

/-- Cohomologous scalar three-cochains have the same cyclic invariant at every element of
finite order dividing `n`. -/
theorem CohomologousTo.cyclicInvariant_eq {ω η : ScalarThreeCochain G} (h : CohomologousTo ω η)
    {g : G} {n : ℕ} (hg : g ^ n = 1) : cyclicInvariant ω g n = cyclicInvariant η g n := by
  obtain ⟨β, rfl⟩ := h
  exact cyclicInvariant_fusionGauge β η hg

/-- A scalar three-cochain with trivial gauge class has cyclic invariant one. -/
theorem cyclicInvariant_eq_one_of_isTrivialGaugeClass {ω : ScalarThreeCochain G}
    (h : IsTrivialGaugeClass ω) {g : G} {n : ℕ} (hg : g ^ n = 1) :
    cyclicInvariant ω g n = 1 := by
  rw [CohomologousTo.cyclicInvariant_eq h hg]
  simp [cyclicInvariant]

/-- A cyclic invariant different from one certifies a nontrivial gauge class. -/
theorem not_isTrivialGaugeClass_of_cyclicInvariant_ne_one {ω : ScalarThreeCochain G} {g : G}
    {n : ℕ} (hg : g ^ n = 1) (hne : cyclicInvariant ω g n ≠ 1) : ¬ IsTrivialGaugeClass ω :=
  fun h ↦ hne (cyclicInvariant_eq_one_of_isTrivialGaugeClass h hg)

/-! ### Restriction along a homomorphism -/

variable {H : Type*} [Group H]

/-- Restriction of a scalar three-cochain along a group homomorphism `f : H →* G`. -/
def comap (f : H →* G) (ω : ScalarThreeCochain G) : ScalarThreeCochain H :=
  fun a b c ↦ ω (f a) (f b) (f c)

@[simp]
theorem comap_apply (f : H →* G) (ω : ScalarThreeCochain G) (a b c : H) :
    comap f ω a b c = ω (f a) (f b) (f c) := rfl

/-- Restriction preserves the three-cocycle equation. -/
theorem IsCocycle.comap {ω : ScalarThreeCochain G} (hω : IsCocycle ω) (f : H →* G) :
    IsCocycle (comap f ω) := by
  intro a b c e
  simpa only [comap_apply, map_mul] using hω (f a) (f b) (f c) (f e)

/-- Restriction commutes with fusion gauges: the gauge of the restriction by the restricted
two-cochain is the restriction of the gauge. -/
theorem comap_fusionGauge (f : H →* G) (β : ScalarCocycle G) (ω : ScalarThreeCochain G) :
    comap f (fusionGauge β ω) = fusionGauge (fun a b ↦ β (f a) (f b)) (comap f ω) := by
  funext a b c
  simp [fusionGauge, coboundary, map_mul]

/-- Restriction preserves cohomologous pairs. -/
theorem CohomologousTo.comap {ω η : ScalarThreeCochain G} (h : CohomologousTo ω η)
    (f : H →* G) : CohomologousTo (comap f ω) (comap f η) := by
  obtain ⟨β, rfl⟩ := h
  exact ⟨fun a b ↦ β (f a) (f b), (comap_fusionGauge f β η).symm⟩

/-- Restriction preserves trivial gauge classes. Contrapositively, a nontrivial restriction to
any subgroup, for instance a cyclic one detected by `cyclicInvariant`, certifies a nontrivial
class on the ambient group. -/
theorem IsTrivialGaugeClass.comap {ω : ScalarThreeCochain G} (h : IsTrivialGaugeClass ω)
    (f : H →* G) : IsTrivialGaugeClass (comap f ω) :=
  CohomologousTo.comap h f

end ScalarThreeCochain

namespace LSymbol

variable {G X H : Type*} [Group G] [MulAction G X] [Group H]

open ScalarThreeCochain

/-- **A subgroup fixing a block trivializes the three-cocycle.** If `L` is compatible with `ω`
(arXiv:2502.20257, `eq:omega_and_Ls`) and every element of the image of `f : H →* G` fixes the
block `x`, then the restriction of `ω` along `f` is the three-coboundary of
`(a, b) ↦ Lˣ_{f a, f b}`.

Source: arXiv:2203.12563, `Papers/2203.12563/REsubmission.tex` lines 740--745, where the
stabilizer `H` of a block `x₀` trivializes `ω|_H` through `pentagongroups`. -/
theorem isTrivialGaugeClass_comap_of_isCompatible {L : LSymbol G X} {ω : ScalarThreeCochain G}
    (hL : IsCompatible L ω) (x : X) (f : H →* G) (hfix : ∀ a, f a • x = x) :
    IsTrivialGaugeClass (comap f ω) := by
  refine ⟨fun a b ↦ L x (f a) (f b), ?_⟩
  funext a b c
  have h := hL x (f a) (f b) (f c)
  rw [hfix c] at h
  simp only [fusionGauge, coboundary, comap_apply, map_mul, mul_one]
  rw [div_eq_iff_eq_mul, h]
  ac_rfl

/-- **A single invariant block forces a trivial gauge class.** If `L` is compatible with `ω`
and some block `x` is fixed by every group element, then `ω` is a three-coboundary, namely the
coboundary of `(g, h) ↦ Lˣ_{g,h}`.

Source: arXiv:2502.20257, `Papers/2502.20257/main.tex` line 1925 ("whenever `|X| = 1` ...
`eq:omega_and_Ls` reduces to the 3-coboundary condition for `ω`") and line 1545 ("An MPU
symmetry group with nontrivial `ω` cannot have an invariant injective MPS"); only the scalar
step is formalized here. -/
theorem isTrivialGaugeClass_of_isCompatible_of_forall_smul_eq {L : LSymbol G X}
    {ω : ScalarThreeCochain G} (hL : IsCompatible L ω) (x : X) (hfix : ∀ g : G, g • x = x) :
    IsTrivialGaugeClass ω := by
  exact isTrivialGaugeClass_comap_of_isCompatible hL x (MonoidHom.id G) hfix

/-- **The anomaly at an involution as a ratio of L-symbols.** If `L` is compatible with `ω`
and `g * g = 1`, then
`ω(g,g,g) = Lˣ_{g,g} Lˣ_{g,1} / (L^{g • x}_{g,g} Lˣ_{1,g})`.

Source: arXiv:2502.20257, `eq:omega_and_Ls` at `(g, g, g)`; the formula is displayed at line
5121 for the CZX example, and at lines 5327--5329 for `(g, g⁻¹, g)`. -/
theorem eq_div_of_isCompatible_of_mul_self_eq_one
    {L : LSymbol G X} {ω : ScalarThreeCochain G} (hL : IsCompatible L ω) (x : X) {g : G}
    (hg : g * g = 1) :
    ω g g g = L x g g * L x g 1 / (L (g • x) g g * L x 1 g) := by
  have h := hL x g g g
  rw [hg] at h
  rw [eq_div_iff_mul_eq']
  rw [mul_comm (L x g g), h]
  simp only [mul_assoc]

end LSymbol

end TNLean.Algebra
