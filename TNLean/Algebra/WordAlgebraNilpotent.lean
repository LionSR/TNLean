import TNLean.Algebra.WordAlgebra
import Mathlib.LinearAlgebra.Quotient.Basic
import QICLean.Algebra.NilMatrixSubalgebra
import QICLean.Algebra.ShiftedZeroTraceNilpotent

/-!
# Nilpotent word-algebra modules

A finite-dimensional module `M` over the word algebra is *nilpotent* when the trace of every
nonempty word on `M` vanishes. Then every word of length at least `dim M` acts as zero;
conversely, if all words of some length act as zero, the module is nilpotent.

## Main results

* `WordAlgebra.ofWord_smul_eq_zero_of_traceWord_eq_zero`
* `WordAlgebra.traceWord_eq_zero_of_forall_ofWord_smul_eq_zero`
-/

namespace WordAlgebra

variable {d : ℕ} {M : Type*} [AddCommGroup M] [Module ℂ M] [Module (WordAlgebra d) M]
  [IsScalarTower ℂ (WordAlgebra d) M] [FiniteDimensional ℂ M]

omit [Module ℂ M] [IsScalarTower ℂ (WordAlgebra d) M] [FiniteDimensional ℂ M] in
/-- If every word of length `n` acts as zero, so does every longer word: split off the prefix
of length `n`. -/
private theorem ofWord_smul_eq_zero_of_length_le {n : ℕ}
    (h : ∀ w : List (Fin d), w.length = n → ∀ m : M, (ofWord w : WordAlgebra d) • m = 0)
    {u : List (Fin d)} (hu : n ≤ u.length) (m : M) : (ofWord u : WordAlgebra d) • m = 0 := by
  rw [← u.take_append_drop n, ofWord_append, mul_smul]
  exact h _ (by simp [List.length_take, Nat.min_eq_left hu]) _

/-- The `k`-th power of a word is a word of length `k |w|`. -/
private theorem exists_ofWord_pow_eq (w : List (Fin d)) (k : ℕ) :
    ∃ u : List (Fin d), u.length = k * w.length ∧ (ofWord w : WordAlgebra d) ^ k = ofWord u := by
  induction k with
  | zero => exact ⟨[], by simp, by simp⟩
  | succ k ih =>
    obtain ⟨u, hu, hpow⟩ := ih
    exact ⟨u ++ w, by simp [hu, Nat.succ_mul], by rw [pow_succ, hpow, ofWord_append]⟩

/-- **Long words vanish on a nilpotent module.** If the trace of every nonempty word on `M`
vanishes, every word of length at least `dim M` acts on `M` as zero. -/
theorem ofWord_smul_eq_zero_of_traceWord_eq_zero
    (h : ∀ w : List (Fin d), w ≠ [] → traceWord M w = 0)
    {w : List (Fin d)} (hw : Module.finrank ℂ M ≤ w.length) (m : M) :
    (ofWord w : WordAlgebra d) • m = 0 := by
  classical
  let ρ : WordAlgebra d →ₐ[ℂ] Module.End ℂ M := Algebra.lsmul ℂ ℂ M
  let S : NonUnitalSubalgebra ℂ (Module.End ℂ M) :=
    NonUnitalAlgebra.adjoin ℂ (Set.range fun i : Fin d => ρ (ofWord [i]))
  -- the subsemigroup generated by the letters consists of nonempty words
  have hword : ∀ X ∈ Subsemigroup.closure (Set.range fun i : Fin d => ρ (ofWord [i])),
      ∃ u : List (Fin d), u ≠ [] ∧ X = ρ (ofWord u) := by
    intro X hX
    induction hX using Subsemigroup.closure_induction with
    | mem X hX =>
      obtain ⟨i, rfl⟩ := hX
      exact ⟨[i], List.cons_ne_nil _ _, rfl⟩
    | mul X Y _ _ hX hY =>
      obtain ⟨u, hu, rfl⟩ := hX
      obtain ⟨v, -, rfl⟩ := hY
      exact ⟨u ++ v, by simp [hu], by rw [ofWord_append, map_mul]⟩
  -- every element of `S` has trace zero
  have htrace : ∀ X ∈ S, LinearMap.trace ℂ M X = 0 := by
    intro X hX
    change X ∈ (NonUnitalAlgebra.adjoin ℂ _).toSubmodule at hX
    rw [NonUnitalAlgebra.adjoin_eq_span] at hX
    induction hX using Submodule.span_induction with
    | mem X hX =>
      obtain ⟨u, hu, rfl⟩ := hword X hX
      exact h u hu
    | zero => simp
    | add X Y _ _ hX hY => rw [map_add, hX, hY, add_zero]
    | smul c X _ hX => rw [map_smul, hX, smul_zero]
  have hpow : ∀ X ∈ S, ∀ N : ℕ, X ^ (N + 1) ∈ S := by
    intro X hX N
    induction N with
    | zero => simpa using hX
    | succ N ih => rw [pow_succ]; exact S.mul_mem ih hX
  -- hence every element of `S` is nilpotent
  have hnil : ∀ X : S, IsNilpotent (X : Module.End ℂ M) := by
    intro X
    let b := Module.finBasis ℂ M
    rw [← LinearMap.isNilpotent_toMatrix_iff b]
    apply Matrix.isNilpotent_of_forall_trace_pow_eq_zero_of_one_lt
    intro N hN
    obtain ⟨N, rfl⟩ : ∃ k, N = k + 1 := ⟨N - 1, by omega⟩
    rw [LinearMap.toMatrix_pow, ← LinearMap.trace_eq_matrix_trace]
    exact htrace _ (hpow _ X.property N)
  -- products of `dim M` letters vanish
  have hlen : ∀ u : List (Fin d), u.length = Module.finrank ℂ M →
      ∀ m : M, (ofWord u : WordAlgebra d) • m = 0 := by
    intro u hu m
    have hprod : ρ (ofWord u) = (u.map fun i => ρ (ofWord [i])).prod := by
      clear hu
      induction u with
      | nil => simp
      | cons i u ih => rw [ofWord_cons, map_mul, ih, List.map_cons, List.prod_cons]
    have h0 : ρ (ofWord u) = 0 := by
      rw [hprod]
      apply S.list_prod_eq_zero_of_forall_isNilpotent hnil
      · intro X hX
        obtain ⟨i, -, rfl⟩ := List.mem_map.mp hX
        exact NonUnitalAlgebra.subset_adjoin ℂ ⟨i, rfl⟩
      · simpa using hu
    simpa [ρ] using LinearMap.congr_fun h0 m
  exact ofWord_smul_eq_zero_of_length_le hlen hw m

omit [FiniteDimensional ℂ M] in
/-- If every word of some length `n` acts on `M` as zero, the trace of every nonempty word on
`M` vanishes. -/
theorem traceWord_eq_zero_of_forall_ofWord_smul_eq_zero {n : ℕ}
    (h : ∀ w : List (Fin d), w.length = n → ∀ m : M, (ofWord w : WordAlgebra d) • m = 0)
    {w : List (Fin d)} (hw : w ≠ []) : traceWord M w = 0 := by
  have hpos : 0 < w.length := by
    cases w with
    | nil => exact absurd rfl hw
    | cons _ _ => simp
  have hnil : IsNilpotent (Algebra.lsmul ℂ ℂ M (ofWord w : WordAlgebra d)) := by
    obtain ⟨u, hu, hpow⟩ := exists_ofWord_pow_eq w n
    refine ⟨n, LinearMap.ext fun m => ?_⟩
    rw [← map_pow, hpow, Algebra.lsmul_apply, LinearMap.zero_apply]
    exact ofWord_smul_eq_zero_of_length_le h (hu ▸ Nat.le_mul_of_pos_right n hpos) m
  rw [traceWord_def]
  exact (LinearMap.isNilpotent_trace_of_isNilpotent hnil).eq_zero

end WordAlgebra
