import TNLean.QCA.SupportAlgebraGeneration
import TNLean.QCA.RelativeCommutant

/-!
# Single-site generation and finite outside commutants

The full observable algebra of a finite region is generated by its single-site
algebras. Consequently a finite matrix is supported in a retained subregion
exactly when it commutes with every single-site observable outside that
subregion. This uses the existing finite relative-commutant theorem and
introduces no new tensor-factor presentation.

These are finite tensor-product facts used for inverse locality in the QCA
appendix of arXiv:1703.09188, lines 2292–2306.
-/

namespace SpinChain

/-- The empty-region algebra consists of scalars and belongs to every
observable subalgebra. Source context: arXiv:1703.09188, Appendix,
identity-tensor inclusions, lines 2292–2295. -/
theorem range_localObservable_empty_le {d : ℕ}
    (S : StarSubalgebra ℂ (AlgebraicLocalAlgebra d)) :
    (localObservable d ∅).range ≤ S := by
  classical
  let : Subsingleton (Config d ∅) := ⟨fun f g => by
    funext x
    exact False.elim (Finset.notMem_empty x.val x.property)⟩
  let x₀ : Config d ∅ := fun x => False.elim (Finset.notMem_empty x.val x.property)
  rintro _ ⟨A, rfl⟩
  have hA : A = algebraMap ℂ (LocalAlgebra d ∅) (A x₀ x₀) := by
    apply CStarMatrix.ext
    intro i j
    rw [Subsingleton.elim i x₀, Subsingleton.elim j x₀]
    simp [CStarMatrix.algebraMap_apply]
  have h := (congrArg (localObservable d ∅) hA).trans
    ((localObservable d ∅).commutes (A x₀ x₀))
  exact h.symm ▸ S.algebraMap_mem (A x₀ x₀)

/-- A finite local algebra is generated by the full single-site algebras
at its sites. This is finite tensor generation underlying the QCA appendix
of arXiv:1703.09188, lines 2292–2295. -/
theorem range_localObservable_le_of_singletons {d : ℕ} [NeZero d]
    (Λ : Finset ℤ) (S : StarSubalgebra ℂ (AlgebraicLocalAlgebra d))
    (hS : ∀ x ∈ Λ, (localObservable d {x}).range ≤ S) :
    (localObservable d Λ).range ≤ S := by
  classical
  revert hS
  induction Λ using Finset.induction_on with
  | empty => intro _; exact range_localObservable_empty_le S
  | @insert x Λ hx ih =>
      intro hS
      rw [show insert x Λ = {x} ∪ Λ by simp,
        range_localObservable_union d (by simpa using hx)]
      exact sup_le (hS x (Finset.mem_insert_self x Λ))
        (ih (fun y hy => hS y (Finset.mem_insert_of_mem hy)))

/-- After a star-homomorphism, commutation with all one-site images
implies commutation with the full finite local image. This is the same
finite generation used in the QCA appendix of arXiv:1703.09188,
lines 2292–2298. -/
theorem commute_map_localObservable_of_singletons
    {d : ℕ} [NeZero d] {A : Type*} [Ring A] [Algebra ℂ A]
    [StarRing A] [StarModule ℂ A]
    (f : AlgebraicLocalAlgebra d →⋆ₐ[ℂ] A) (Λ : Finset ℤ) (z : A)
    (hcomm : ∀ x ∈ Λ, ∀ C : LocalAlgebra d {x},
      Commute z (f (localObservable d {x} C))) (B : LocalAlgebra d Λ) :
    Commute z (f (localObservable d Λ B)) := by
  let T := StarSubalgebra.centralizer ℂ ({z} : Set A)
  let S := T.comap f
  have hS : ∀ x ∈ Λ, (localObservable d {x}).range ≤ S := by
    intro x hx C hC
    obtain ⟨C, rfl⟩ := hC
    change f (localObservable d {x} C) ∈ T
    rw [StarSubalgebra.mem_centralizer_iff]
    intro y hy
    have hyz : y = z := Set.mem_singleton_iff.mp hy
    subst y
    refine ⟨(hcomm x hx C).eq, ?_⟩
    have hstar := (hcomm x hx (star C)).star_star
    simpa only [map_star, star_star] using! hstar.eq
  have hB : f (localObservable d Λ B) ∈ T :=
    range_localObservable_le_of_singletons Λ S hS ⟨B, rfl⟩
  exact ((StarSubalgebra.mem_centralizer_iff ℂ).mp hB z (Set.mem_singleton z)).1

/-- Commutation with every single-site algebra in a finite region implies
commutation with its full observable algebra. Source context:
arXiv:1703.09188, Appendix, local observable algebras, lines 2292–2298. -/
theorem commute_localObservable_of_singletons {d : ℕ} [NeZero d]
    (Λ : Finset ℤ) (z : AlgebraicLocalAlgebra d)
    (hcomm : ∀ x ∈ Λ, ∀ C : LocalAlgebra d {x}, Commute z (localObservable d {x} C))
    (B : LocalAlgebra d Λ) : Commute z (localObservable d Λ B) :=
  commute_map_localObservable_of_singletons (StarAlgHom.id ℂ _) Λ z hcomm B

/-- A finite observable is in the retained local algebra exactly when it
commutes with every outside single-site observable. This is the finite
relative-commutant characterization used to reflect forward locality.
Source context: arXiv:1703.09188, Appendix, lines 2292–2306. -/
theorem mem_range_localInclusion_iff_commute_outside_singletons
    {d : ℕ} [NeZero d] {K Γ : Finset ℤ} (hK : K ⊆ Γ) (A : LocalAlgebra d Γ) :
    A ∈ Set.range (localInclusion (d := d) hK) ↔
      ∀ (x : ℤ) (hx : x ∈ Γ \ K) (C : LocalAlgebra d {x}),
        Commute A (localInclusion
          (Finset.singleton_subset_iff.mpr (Finset.mem_sdiff.mp hx).1) C) := by
  classical
  constructor
  · intro hA x hx C
    have hFull := (mem_range_localInclusion_iff_commute_complement hK A).mp hA
    let hxK : ({x} : Finset ℤ) ⊆ Γ \ K := Finset.singleton_subset_iff.mpr hx
    have h := hFull (localInclusion hxK C)
    simpa only [← StarAlgHom.comp_apply, localInclusion_trans] using h
  · intro hSites
    apply (mem_range_localInclusion_iff_commute_complement hK A).mpr
    intro B
    rw [commute_iff_eq]
    apply localObservable_injective d Γ
    rw [map_mul, map_mul]
    have hAll := commute_localObservable_of_singletons (Γ \ K) (localObservable d Γ A)
      (fun x hx C => by
        have hc := (hSites x hx C).map (localObservable d Γ)
        simpa only [localObservable_localInclusion] using hc) B
    simpa only [localObservable_localInclusion] using hAll.eq

end SpinChain
