# This file configures the latexmk command you can use to compile
# the pdf version of the blueprint
$pdf_mode = 1;
$pdflatex = 'xelatex -synctex=1';
# The full volume exhausts XeTeX's default string pool while recording the
# generated names of its many TikZ/Tenkz objects. This is runtime capacity;
# no format rebuild is needed. Keep an explicit caller override intact.
$ENV{'pool_size'} //= 12500000;
# The accumulated TikZ/Tenkz boxes likewise outgrow the default main memory at
# the final shipout of the full volume. Unlike the string pool above, XeTeX
# fixes the size of its main memory (the node array) when the format is dumped:
# at run time the eTeX-extended engine ignores main_memory and extra_mem_*, so
# the capacity message keeps reporting the 5000000-word default no matter what
# the environment holds. The only lever is to bake a larger node array into the
# format. Regenerate the xelatex format once (fmtutil runs the ini dump that
# reads main_memory from the environment) and let the following compiles load
# it. Best-effort: if regeneration fails the stock format stays in place and
# the build behaves exactly as before, never worse.
$ENV{'main_memory'} = 20000000;
{
  my $marker = ($ENV{'HOME'} // '.') . '/.tnlean_xelatex_bigmem';
  unless (-e $marker) {
    # Prefer rewriting the shared system format (the one the subsequent compiles
    # load): passwordless sudo on the CI runner makes this the reliable path,
    # and `sudo -n` fails fast rather than blocking for a password elsewhere.
    # Fall back to a writable system tree, then to a user-local format.
    my $ok =
      (system('sudo', '-n', 'fmtutil-sys', '--byfmt', 'xelatex') == 0)
      || (system('fmtutil-sys', '--byfmt', 'xelatex') == 0)
      || (system('fmtutil', '--user', '--byfmt', 'xelatex') == 0);
    if ($ok) {
      if (open(my $fh, '>', $marker)) { close($fh); }
    } else {
      warn "latexmkrc: could not regenerate the xelatex format with a larger "
        . "main_memory; the stock 5000000-word format will be used\n";
    }
  }
}
@default_files = ('print.tex');
use Cwd qw(abs_path);
use File::Spec;
my $tenkz_root = $ENV{'TENKZ_ROOT'} // '../../.deps/tenkz';
$tenkz_root = abs_path($tenkz_root) // File::Spec->rel2abs($tenkz_root);
# MiKTeX reads TEXINPUTS with ';' and needs a Windows path; under MSYS or Cygwin
# perl, abs_path gives a Unix-style path, which cygpath converts.
my $windows = ($^O =~ /^(MSWin32|msys|cygwin)$/);
if ($windows && $^O ne 'MSWin32') {
  my $converted = `cygpath -m "$tenkz_root"`;
  chomp $converted;
  $tenkz_root = $converted if $converted ne '';
}
$ENV{'TEXINPUTS'} =
  "$tenkz_root/tex/tenkz//" . ($windows ? ';' : ':')
  . ($ENV{'TEXINPUTS'} // '');
