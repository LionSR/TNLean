import TNLean.PEPS.Approximation.CanonicalPartyFactorization
import Lean.Elab.Command
import Lean.Util.CollectAxioms

/-! # Axiom guard for factorization by actual singleton restrictions

The factorization theorem must exist in the production module and depend only
on standard logical axioms.
-/

set_option linter.hashCommand false

run_cmd do
  let allowed := #[``propext, ``Classical.choice, ``Quot.sound]
  let env ← Lean.getEnv
  for decl in #[``TNLean.PEPS.PairEffect.Word.groupByPartyIso_eval_eq_tensorRestrictions] do
    unless env.contains decl do
      throwError "Missing declaration {decl}"
    let axioms ← Lean.collectAxioms decl
    unless axioms.all (allowed.contains ·) do
      throwError "Unexpected axioms for {decl}: {axioms}"
    Lean.logInfo m!"{decl}: {axioms}"
